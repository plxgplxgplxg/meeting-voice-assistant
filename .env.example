# ==============================================================================
# MEETING VOICE ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Sao chép tệp này thành .env và điền các giá trị thực tế trước khi khởi động.
# Lệnh: cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Cấu hình Ứng dụng & Chung (General Settings)
# ------------------------------------------------------------------------------
PROJECT_NAME="Meeting Voice Assistant"
ENVIRONMENT=production
DEBUG=false
STORAGE_ROOT=/tmp/meeting_storage

# Khóa bí mật bảo mật cho JSON Web Token (JWT).
# Khuyến nghị tạo chuỗi ngẫu nhiên 64 ký tự bằng lệnh: openssl rand -hex 32
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# 2. Cơ sở dữ liệu PostgreSQL + pgvector
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=meeting_intelligence
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL dùng cho backend kết nối tới container postgres
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_postgres_password_here@postgres:5432/meeting_intelligence

# ------------------------------------------------------------------------------
# 3. Redis Message Broker & Cache (Dùng cho Celery & Quota/Session)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. Trí tuệ Nhân tạo - Audio Pipeline (Gladia API v2)
# ------------------------------------------------------------------------------
# Đăng ký nhận API Key miễn phí tại: https://app.gladia.io/
AUDIO_PIPELINE_ENGINE=gladia
GLADIA_API_KEY=your_gladia_api_key_here
GLADIA_BASE_URL=https://api.gladia.io

# ------------------------------------------------------------------------------
# 5. Mô hình Ngôn ngữ Lớn - LLM (Tóm tắt biên bản & Trợ lý RAG)
# ------------------------------------------------------------------------------
# Chọn nhà cung cấp: 'gemini' (Khuyến nghị, tốc độ nhanh, miễn phí) hoặc 'openai'
LLM_PROVIDER=gemini

# Lấy Gemini API Key miễn phí từ Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# (Tùy chọn) OpenAI API Key nếu đổi LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 6. Mô hình Embedding (RAG Vector Search trên CPU)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
DEVICE=cpu

# ------------------------------------------------------------------------------
# 7. Cổng thanh toán VietQR & SePay Webhook
# ------------------------------------------------------------------------------
# Cấu hình tài khoản ngân hàng hiển thị trên mã VietQR Napas247 động
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_NUMBER=0987654321
SEPAY_ACCOUNT_NAME=NGUYEN PHUONG LINH

# API Key xác thực Webhook được sinh trong Dashboard của SePay (https://my.sepay.vn)
SEPAY_WEBHOOK_API_KEY=your_sepay_webhook_api_key_here

# ------------------------------------------------------------------------------
# 8. Địa chỉ giao tiếp nội bộ giữa các Service
# ------------------------------------------------------------------------------
BACKEND_API_URL=http://backend-api:8000
AI_SERVICE_URL=http://ai-service:8001

# Địa chỉ Backend API cung cấp cho Frontend Next.js trên trình duyệt người dùng:
# - Chạy cục bộ: http://localhost:8000
# - Chạy EC2 có Nginx: để trống ("") hoặc URL domain ví dụ https://meeting.yourdomain.com
# - Chạy EC2 không Nginx: http://<EC2_PUBLIC_IP>:8000
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
